# Etapa 20 - variables de entorno para docker-compose.yml (staging o
# produccion). Copiar a `.env` en el mismo directorio y completar con
# valores reales - `.env` NUNCA se commitea (ya esta en .gitignore).
#
# Generar las claves JWT (RSA, formato que espera JwtKeyProvider):
#   mkdir -p secrets/jwt
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out secrets/jwt/private.pem
#   openssl rsa -pubout -in secrets/jwt/private.pem -out secrets/jwt/public.pem
#
# Generar TOKEN_ENCRYPTION_KEY (AES-256, cualquier string aleatorio largo):
#   openssl rand -base64 32

# --- Entorno ---
SPRING_PROFILES_ACTIVE=prod
# o "staging" para el entorno de staging (etapa 19)

# --- Dominios (deben apuntar por DNS a este servidor antes de levantar Caddy,
# o el certificado TLS automatico de Let's Encrypt va a fallar) ---
API_DOMAIN=api.easybeach.com.ar
WEB_DOMAIN=app.easybeach.com.ar

# --- Base de datos ---
DB_USERNAME=easybeach
DB_PASSWORD=cambiar-por-una-contrasena-real-larga
DB_ROOT_PASSWORD=cambiar-por-otra-distinta

# --- JWT (ver instrucciones arriba) ---
JWT_KEYS_HOST_DIR=./secrets/jwt

# --- Cifrado de tokens de Mercado Pago en reposo ---
TOKEN_ENCRYPTION_KEY=

# --- Mercado Pago OAuth (app registrada en https://www.mercadopago.com.ar/developers) ---
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://api.easybeach.com.ar/api/v1/mercadopago/oauth/callback
